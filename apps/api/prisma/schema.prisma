generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum OrganizationType {
  GOVERNMENT
  TRAINING_INSTITUTE
  EMPLOYER
  INDUSTRY_BODY
  OTHER
}

enum UserRole {
  PLATFORM_ADMIN
  GOVERNMENT_MANAGER
  INSTITUTE_ADMIN
  EMPLOYER
  TRAINER
  LEARNER
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DataSourceType {
  GOVERNMENT
  PUBLIC_DATASET
  EMPLOYER
  INDUSTRY_REPORT
  JOB_BOARD
  TRAINING
  OTHER
}

enum EvidenceType {
  JOB_POSTING
  DATASET
  REPORT
  SUBMISSION
  OTHER
}

enum SkillImportance {
  REQUIRED
  PREFERRED
  NICE_TO_HAVE
}

enum SkillProficiency {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum RecommendationType {
  CURRICULUM_UPDATE
  NEW_COURSE
  SKILL_PRIORITY
  POLICY
}

enum RecommendationStatus {
  DRAFT
  ACTIVE
  ACCEPTED
  REJECTED
  ARCHIVED
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType
  isDemo    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz

  users   User[]
  courses Course[]

  @@index([type])
}

model User {
  id             String    @id @default(uuid())
  clerkUserId    String    @unique
  organizationId String?
  role           UserRole
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([role])
}

model Location {
  id        String   @id @default(uuid())
  country   String
  state     String
  district  String?
  city      String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  jobs                Job[]
  demandObservations  DemandObservation[]
  skillGaps           SkillGap[]
  recommendations     Recommendation[]

  @@index([country, state])
  @@index([state])
  @@index([city])
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  occupations        Occupation[]
  jobs               Job[]
  courses            Course[]
  demandObservations DemandObservation[]
}

model Occupation {
  id          String   @id @default(uuid())
  name        String
  code        String?
  description String?
  sectorId    String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  sector             Sector?              @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  jobs               Job[]
  courses            Course[]
  demandObservations DemandObservation[]
  recommendations    Recommendation[]

  @@index([sectorId])
  @@index([name])
}

model Skill {
  id            String   @id @default(uuid())
  name          String
  canonicalName String   @unique
  description   String?
  category      String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  jobSkills          JobSkill[]
  curriculumSkills   CurriculumSkill[]
  demandObservations DemandObservation[]
  skillGaps          SkillGap[]
  recommendations    Recommendation[]

  @@index([category])
}

model Job {
  id           String    @id @default(uuid())
  title        String
  description  String?
  companyName  String?
  sourceId     String?
  externalId   String?
  locationId   String?
  occupationId String?
  sectorId     String?
  postedAt     DateTime? @db.Timestamptz
  expiresAt    DateTime? @db.Timestamptz
  sourceUrl    String?
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  source     DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  sector     Sector?     @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  skills     JobSkill[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([locationId])
  @@index([occupationId])
  @@index([sectorId])
}

model JobSkill {
  id           String            @id @default(uuid())
  jobId        String
  skillId      String
  importance   SkillImportance?
  proficiency  SkillProficiency?
  createdAt    DateTime          @default(now()) @db.Timestamptz
  updatedAt    DateTime          @updatedAt @db.Timestamptz

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model Course {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  occupationId   String?
  sectorId       String?
  durationHours  Int?
  status         CourseStatus @default(DRAFT)
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  occupation   Occupation?  @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  sector       Sector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  curricula    Curriculum[]

  @@index([organizationId])
  @@index([occupationId])
  @@index([sectorId])
}

model Curriculum {
  id            String    @id @default(uuid())
  courseId      String
  version       String
  title         String
  description   String?
  effectiveFrom DateTime? @db.Timestamptz
  effectiveTo   DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skills          CurriculumSkill[]
  skillGaps       SkillGap[]
  recommendations Recommendation[]

  @@unique([courseId, version])
  @@index([courseId])
}

model CurriculumSkill {
  id           String            @id @default(uuid())
  curriculumId String
  skillId      String
  importance   SkillImportance?
  proficiency  SkillProficiency?
  createdAt    DateTime          @default(now()) @db.Timestamptz
  updatedAt    DateTime          @updatedAt @db.Timestamptz

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, skillId])
  @@index([skillId])
}

model DataSource {
  id          String         @id @default(uuid())
  name        String         @unique
  type        DataSourceType
  url         String?
  description String?
  reliability Float?
  active      Boolean        @default(true)
  isDemo      Boolean        @default(false)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  jobs     Job[]
  evidence Evidence[]
}

model Evidence {
  id          String       @id @default(uuid())
  sourceId    String
  type        EvidenceType
  reference   String?
  observedAt  DateTime?    @db.Timestamptz
  confidence  Float?
  metadata    Json?
  createdAt   DateTime     @default(now()) @db.Timestamptz

  source             DataSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  demandObservations DemandObservation[]

  @@index([sourceId])
  @@index([observedAt])
}

model DemandObservation {
  id           String    @id @default(uuid())
  skillId      String?
  occupationId String?
  sectorId     String?
  locationId   String?
  evidenceId   String?
  periodStart  DateTime  @db.Timestamptz
  periodEnd    DateTime? @db.Timestamptz
  demandScore  Float?
  sampleSize   Int?
  confidence   Float?
  createdAt    DateTime  @default(now()) @db.Timestamptz

  skill      Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  sector     Sector?     @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  evidence   Evidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([skillId])
  @@index([locationId])
  @@index([periodStart])
}

model SkillGap {
  id           String   @id @default(uuid())
  curriculumId String
  skillId      String
  locationId   String?
  severity     String?
  gapScore     Float?
  confidence   Float?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  location   Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([skillId])
  @@index([curriculumId])
  @@index([locationId])
}

model Recommendation {
  id           String               @id @default(uuid())
  type         RecommendationType
  title        String
  description  String?
  priority     Int?
  confidence   Float?
  status       RecommendationStatus @default(DRAFT)
  curriculumId String?
  skillId      String?
  occupationId String?
  locationId   String?
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @updatedAt @db.Timestamptz

  curriculum Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  skill      Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([curriculumId])
  @@index([skillId])
}
