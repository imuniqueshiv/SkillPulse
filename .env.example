# Phase 1 — local development
NODE_ENV=development

# Express API (apps/api) — http://localhost:4000
API_PORT=4000

# Comma-separated browser origins for CORS (no wildcard in production)
CORS_ORIGINS=http://localhost:3000

# Optional Express JSON body size (default 100kb)
# JSON_BODY_LIMIT=100kb

# Trust reverse-proxy headers (default true when NODE_ENV=production)
# TRUST_PROXY=true

# Next.js frontend (apps/web) — http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# FastAPI intelligence service (services/intelligence) — http://localhost:8000
# Optional — Express does not require it for Phase 7–14 intelligence.
INTELLIGENCE_SERVICE_URL=http://localhost:8000
INTELLIGENCE_PORT=8000

# Neon PostgreSQL (apps/api + Prisma only — never expose to Next.js)
# Required in production (NODE_ENV=production).
# DATABASE_URL = pooled Neon connection (Prisma runtime)
# DIRECT_URL   = unpooled Neon connection (Prisma migrations)
# If you do not have a pooled endpoint yet, set both to the same unpooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk (Phase 3)
# Publishable key is safe for the Next.js client bundle.
# Secret key is server-only: Next.js proxy + Express API. Never prefix with NEXT_PUBLIC_.
# CLERK_SECRET_KEY is required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional Phase 17.2 NCS acquisition (never enables scraping)
# NCS_LIVE_ENABLED=true is rejected — it does not scrape ncs.gov.in.
# NCS_ACQUISITION_MODE=disabled|synthetic|file|api|public
# AUTHORIZED_API requires an official feed URL + token. Do not point this at
# the public NCS website HTML/SPA. SkillPulse will not invent NCS endpoints.
# NCS_API_BASE_URL=
# NCS_API_TOKEN=
# PUBLIC_PAGE requires documented terms review. Even when permitted, no page
# collector is shipped in this phase — acquisition refuses rather than scrape.
# NCS_PUBLIC_PAGE_PERMITTED=false
# NCS_RAW_RETENTION_DAYS=90
# NCS_SCHEDULE_INTERVAL_HOURS=24
# Use: pnpm --filter api ncs:ingest -- --mode synthetic|file|api --state Maharashtra
# Scheduled live ticks only run when mode is AUTHORIZED_API or AUTHORIZED_FILE.
